{
  "regions": [
    "sin1"
  ],
  "rewrites": [
    {
      "source": "/api/auth/:provider/callback",
      "destination": "/api/auth?action=callback&provider=:provider"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.(jpg|jpeg|png|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
